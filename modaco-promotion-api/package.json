{
  "name": "modaco-promotion-api",
  "version": "1.0.0",
  "private": true,
  "description": "ModaCo Promotion Management API - internal product catalog and promotions API",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "fixture": "tsx scripts/generate-fixture.ts",
    "ingest": "tsx scripts/local-ingest.ts",
    "lambda:build": "esbuild lambdas/orchestrator.ts lambdas/pricing-worker.ts --bundle --platform=node --target=node20 --outdir=dist-lambda --external:@prisma/client --external:@aws-sdk/client-s3 --external:@aws-sdk/client-sqs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1100.0",
    "@aws-sdk/client-sqs": "^3.1100.0",
    "@prisma/client": "^6.19.3",
    "busboy": "^1.6.0",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "redis": "^4.7.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/busboy": "^1.5.4",
    "@types/csv-parse": "^1.1.12",
    "@types/express": "^4.17.25",
    "@types/node": "^24.13.3",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.24.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
