# ============================================================
# ModaCo Promotion Management API - .gitignore
# Based on github/gitignore best practices for Node.js and
# Windows, plus tool-specific rules for the stack in use:
# Node.js 24 / TypeScript / Express / Prisma / Redis /
# PostgreSQL (Docker) / AWS SAM + Lambda / vitest / esbuild.
# ============================================================

# ---------- Logs ----------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ---------- Runtime data ----------
pids
*.pid
*.seed
*.pid.lock

# ---------- Coverage ----------
coverage
*.lcov
.nyc_output

# ---------- Dependencies ----------
node_modules/
jspm_packages/
web_modules/

# ---------- Build output ----------
dist/
dist-lambda/
build/
out/
*.tsbuildinfo

# ---------- Env / secrets (NEVER commit) ----------
# .env and any environment-specific variants hold
# DATABASE_URL, Redis and AWS credentials.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
secrets/
.aws/
aws_credentials

# ---------- Runtime data for this app ----------
# CSV uploads, local queue chunks and generated fixtures.
data/

# ---------- npm cache / misc ----------
.npm
.eslintcache
.stylelintcache
.node_repl_history
*.tgz
.yarn-integrity
.cache
.parcel-cache

# ---------- AWS SAM / Serverless ----------
.aws-sam/
samconfig.toml
.serverless/

# ---------- Docker ----------
docker-compose.override.yml

# ---------- Editor / IDE ----------
.vscode/
.idea/
*.swp
*.swo
.tern-port

# ---------- OS files ----------
.DS_Store
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump
*.lnk
modaco-promotion-api/opencode.json
opencode.json
.playwright-mcp
